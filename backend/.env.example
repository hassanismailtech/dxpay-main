# Copy to backend/.env for local development. Never commit real credentials.
PORT=5000
FRONTEND_URL=http://localhost:3000

# Local PostgreSQL. DATABASE_URL may be used instead of the PG fields.
PGHOST=localhost
PGPORT=5432
PGDATABASE=dxpay
PGUSER=postgres
PGPASSWORD=
# Local databases normally disable TLS. Remote databases verify certificates.
# Use verify-full for a TLS-enabled remote database; never disable validation.
PGSSLMODE=disable
DATABASE_URL=

# Only reachable inside the Forge team namespace. Leave key empty locally.
BANK_API_URL=http://bank-api.ingress-apisix.svc.cluster.local/v1
FORGE_MERCHANT_ID=mer_204
GATEWAY_KEY=
