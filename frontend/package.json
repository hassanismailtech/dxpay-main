{
  "name": "dxpay-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:payment": "node --test src/features/payment/test/*.test.mjs",
    "format": "prettier --ignore-path ../.prettierignore --write src tests *.ts *.mjs *.json",
    "format:check": "prettier --ignore-path ../.prettierignore --check src tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "next": "16.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
