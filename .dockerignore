# Default-deny build context: only runtime source and lockfiles are required.
**
!Dockerfile
!.dockerignore
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/next.config.ts
!frontend/tsconfig.json
!frontend/postcss.config.mjs
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!backend/
!backend/package.json
!backend/package-lock.json
!backend/server.js
!backend/config/
!backend/config/**
!backend/routes/
!backend/routes/**
!backend/utils/
!backend/utils/**
# Explicit final exclusions override allow rules.
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules/
**/.next/
**/test/
**/tests/
**/test-results/
